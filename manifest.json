{
  "manifest_version": 3,
  "name": "DEMYSTIFY",
  "version": "0.8",
  "description": "Replaces marketing fluff with what the website actually does.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["learn.js", "analyzer.js", "content.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_title": "Demystify settings",
    "default_popup": "popup.html"
  }, 

  "browser_specific_settings": {
  "gecko": { "id": "{7235d94a-1929-40c5-80b5-4e8d1eb7bed5}" }
}
}